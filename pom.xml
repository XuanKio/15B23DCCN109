<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.ptit</groupId>
    <artifactId>CineMan9</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>
    <name>CineMan9 - Hệ thống quản lí rạp chiếu phim</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cineman.port>8080</cineman.port>
    </properties>

    <dependencies>
        <!-- Apache Tomcat 10.1 cung cấp Servlet/JSP khi chạy -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- JDBC driver cho MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>CineMan9</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <!-- mvn package cargo:run : tự tải Tomcat 10.1, deploy CineMan9.war và chạy ở http://localhost:8080/CineMan9/ -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>1.10.13</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <zipUrlInstaller>
                            <url>https://archive.apache.org/dist/tomcat/tomcat-10/v10.1.34/bin/apache-tomcat-10.1.34.zip</url>
                            <!-- Đặt Tomcat ở thư mục người dùng: đường dẫn có dấu tiếng Việt làm Tomcat không khởi động được -->
                            <downloadDir>${user.home}/.cineman9/downloads</downloadDir>
                            <extractDir>${user.home}/.cineman9/installs</extractDir>
                        </zipUrlInstaller>
                    </container>
                    <configuration>
                        <home>${user.home}/.cineman9/tomcat-config</home>
                        <properties>
                            <cargo.servlet.port>${cineman.port}</cargo.servlet.port>
                        </properties>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>edu.ptit</groupId>
                            <artifactId>CineMan9</artifactId>
                            <type>war</type>
                            <properties>
                                <context>/CineMan9</context>
                            </properties>
                        </deployable>
                    </deployables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
